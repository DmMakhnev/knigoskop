COMPOSE_PROJECT_NAME=knigoskop-staging
RELEASE_TAG=phase9
STAGING_DOMAIN=test.example.com
STAGING_GATE_USER=reviewer
STAGING_GATE_HASH=
POSTGRES_DB=knigoskop
POSTGRES_ADMIN_PASSWORD=
APP_POSTGRES_USER=knigoskop_app
APP_POSTGRES_PASSWORD=
APP_ENV=production
PUBLIC_BASE_URL=https://test.example.com
ALLOWED_ORIGINS=["https://test.example.com"]
SESSION_COOKIE_SECURE=true
MAIL_BACKEND=disabled
REGISTRATION_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
AI_MASTER_KEY=
AI_ALLOWED_HOSTS=["routerai.ru","api.genvoice.ru","tts.api.cloud.yandex.net"]
KNIGOSKOP_LLM_API_KEY=
KNIGOSKOP_TTS_API_KEY=
KNIGOSKOP_YANDEX_TTS_API_KEY=
AI_ENV_PROVIDER_HOST=routerai.ru
TTS_ENV_PROVIDER_HOST=api.genvoice.ru
TTS_BASE_URL=https://api.genvoice.ru/v1
YANDEX_TTS_ENV_PROVIDER_HOST=tts.api.cloud.yandex.net
AI_TIMEOUT_SECONDS=120
STORAGE_DIRECTORY=/app/.local/files
MAIL_DIRECTORY=/app/.local/mail
