APP_ENV=development
PUBLIC_BASE_URL=http://localhost:15173
ALLOWED_ORIGINS=["http://localhost:15173","http://127.0.0.1:15173"]
# Только локальный HTTP. Для HTTPS: true.
SESSION_COOKIE_SECURE=false
POSTGRES_DB=knigoskop
POSTGRES_USER=knigoskop
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
STORAGE_DIRECTORY=/app/.local/files
MAIL_DIRECTORY=/app/.local/mail
# Настоящие ключи задаются вне Git. JSON-массив обязателен для AI_ALLOWED_HOSTS.
AI_ALLOWED_HOSTS=[]
AI_ENV_PROVIDER_HOST=
AI_TIMEOUT_SECONDS=10
AI_MASTER_KEY=
KNIGOSKOP_LLM_API_KEY=
# Отдельные порты и имя проекта не используют действующие контейнеры восстановления.
API_PORT=18000
FRONTEND_PORT=15173

# GenVoice: ключ в защищённых настройках среды, не в Git.
KNIGOSKOP_TTS_API_KEY=
TTS_ENV_PROVIDER_HOST=api.genvoice.ru
TTS_BASE_URL=https://api.genvoice.ru/v1
# Для реального вызова добавить api.genvoice.ru в JSON-массив AI_ALLOWED_HOSTS.
# Базовый URL профиля в админке: https://api.genvoice.ru/v1
AUDIO_SEGMENT_CHARS=1000
AUDIO_MAX_TEXT_CHARS=20000
QUOTA_DAILY_TTS_CHARS=10000

# Альтернативный серверный TTS: SpeechKit v1, ключ сервисного аккаунта (Api-Key).
KNIGOSKOP_YANDEX_TTS_API_KEY=
YANDEX_TTS_ENV_PROVIDER_HOST=tts.api.cloud.yandex.net
# В админке выбрать yandex_speechkit, базовый URL https://tts.api.cloud.yandex.net.
# Добавить tts.api.cloud.yandex.net в AI_ALLOWED_HOSTS перед реальной проверкой.
